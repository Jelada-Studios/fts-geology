{
  "multipart": [
    {"apply": {"model": "fts_geology:block/gas_pipe_core"}},
    {"when": {"north": "true"}, "apply": {"model": "fts_geology:block/gas_pipe_arm"}},
    {"when": {"south": "true"}, "apply": {"model": "fts_geology:block/gas_pipe_arm", "y": 180}},
    {"when": {"east": "true"}, "apply": {"model": "fts_geology:block/gas_pipe_arm", "y": 90}},
    {"when": {"west": "true"}, "apply": {"model": "fts_geology:block/gas_pipe_arm", "y": 270}},
    {"when": {"up": "true"}, "apply": {"model": "fts_geology:block/gas_pipe_arm", "x": 270}},
    {"when": {"down": "true"}, "apply": {"model": "fts_geology:block/gas_pipe_arm", "x": 90}}
  ]
}
